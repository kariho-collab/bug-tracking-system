<%- include('partials/shell-start', { user: user, active: 'bugs', title: 'Bug #' + bug.bug_id + ' — BugTracker' }) %>
        <a class="crumbs enter" style="--i:0" href="/bugs">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          Back to bug tracker
        </a>
        <header class="page-head" style="--i:0">
          <div>
            <h1><%= bug.title %></h1>
            <div class="badges">
              <span class="badge neutral">Bug #<%= bug.bug_id %></span>
              <span class="badge <%= bug.priority %>"><%= bug.priority %></span>
              <span class="badge js-status-badge <%= bug.status.replace(' ', '-') %>"><%= bug.status %></span>
              <span class="badge neutral"><%= bug.category %></span>
            </div>
          </div>
        </header>

        <div class="detail-layout enter" style="--i:1">
          <div class="col">
            <section class="card" aria-labelledby="descTitle">
              <h2 class="card-title" id="descTitle">Description</h2>
              <p class="desc"><%= bug.description %></p>
            </section>

            <section class="card" aria-labelledby="actTitle">
              <h2 class="card-title" id="actTitle">Activity</h2>
              <p class="card-sub">Status changes, assignments and comments, oldest first.</p>
              <% if (comments.length === 0) { %>
                <p class="muted">No activity yet. Add the first comment below.</p>
              <% } else { %>
              <ol class="timeline">
                <% comments.forEach(c => { %>
                <li class="<%= (c.comment_text.indexOf('Status changed') === 0 || c.comment_text.indexOf('Assigned to') === 0) ? 'is-system' : '' %>">
                  <div class="text"><%= c.comment_text %></div>
                  <div class="meta"><%= c.author %> on <%= c.timestamp %></div>
                </li>
                <% }) %>
              </ol>
              <% } %>
              <form method="POST" action="/bugs/<%= bug.bug_id %>/comment" class="comment-form">
                <label class="sr-only" for="comment_text">Comment</label>
                <textarea id="comment_text" name="comment_text" placeholder="Add a comment" required></textarea>
                <div><button class="btn btn-sm" type="submit">Add comment</button></div>
              </form>
            </section>
          </div>

          <aside class="col" aria-label="Bug details and actions">
            <section class="card" aria-labelledby="factsTitle">
              <h2 class="card-title" id="factsTitle">Details</h2>
              <dl class="facts" style="margin-top:14px">
                <div><dt>Reported by</dt><dd><%= bug.reported_by_name %></dd></div>
                <div><dt>Reported on</dt><dd><%= bug.date_reported.slice(0, 10) %></dd></div>
                <div><dt>Assigned to</dt><dd><%= bug.assigned_to_name || 'Unassigned' %></dd></div>
                <div><dt>Category</dt><dd><%= bug.category %></dd></div>
              </dl>
            </section>

            <section class="card collapsible is-open" data-collapsible>
              <button class="collapsible-head" type="button" aria-expanded="true" aria-controls="manageBody">
                Manage this bug
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="collapsible-body" id="manageBody">
                <div class="collapsible-inner">
                  <div class="pad">
                    <form method="POST" action="/bugs/<%= bug.bug_id %>/status" class="stack">
                      <div class="field">
                        <label for="status">Status</label>
                        <select id="status" name="status">
                          <% ['Open','In Progress','Resolved','Closed','Reopened'].forEach(s => { %>
                            <option <%= bug.status === s ? 'selected' : '' %>><%= s %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div><button class="btn btn-sm" type="submit">Update status</button></div>
                    </form>
                    <form method="POST" action="/bugs/<%= bug.bug_id %>/assign" class="stack">
                      <div class="field">
                        <label for="assigned_to">Assign to</label>
                        <select id="assigned_to" name="assigned_to">
                          <option value="">Unassigned</option>
                          <% developers.forEach(d => { %>
                            <option value="<%= d.user_id %>" <%= bug.assigned_to === d.user_id ? 'selected' : '' %>><%= d.name %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div><button class="btn btn-sm btn-ghost" type="submit">Save assignee</button></div>
                    </form>
                  </div>
                </div>
              </div>
            </section>
          </aside>
        </div>
<%- include('partials/shell-end') %>
