<%- include('partials/shell-start', { user: user, active: 'reports', title: 'Reports — BugTracker' }) %>
<%
  const order = ['Open', 'In Progress', 'Resolved', 'Closed', 'Reopened'];
  const rgb = { 'Open': '34,211,238', 'In Progress': '167,139,250', 'Resolved': '52,211,153', 'Closed': '100,116,139', 'Reopened': '244,114,182' };
  const statuses = order.map(n => byStatus.find(s => s.status === n)).filter(Boolean);
  const pct = (n) => totalBugs ? Math.round((n / totalBugs) * 1000) / 10 : 0;
  const maxCount = Math.max(1, ...byCategory.map(c => c.count));
  const plural = (n) => n + (n === 1 ? ' bug' : ' bugs');
%>
        <header class="page-head" style="--i:0">
          <div>
            <h1>Reports</h1>
            <p>How bugs are distributed and how quickly they get resolved, calculated from your live data.</p>
          </div>
        </header>

        <section class="stats stats-3 enter" style="--i:1" data-inview aria-label="Summary figures">
          <div class="card stat c-neutral">
            <div class="stat-top"><span>Total bugs logged</span><span class="stat-dot" aria-hidden="true"></span></div>
            <div class="stat-value" data-count="<%= totalBugs %>"><%= totalBugs %></div>
            <p class="stat-note">Across all categories and statuses</p>
          </div>
          <div class="card stat c-resolved">
            <div class="stat-top"><span>Average time to resolve</span><span class="stat-dot" aria-hidden="true"></span></div>
            <% if (avgResolutionDays !== null) { %>
            <div class="stat-value"><span data-count="<%= avgResolutionDays %>" data-decimals="1"><%= avgResolutionDays %></span><small>days</small></div>
            <p class="stat-note">From report to resolution</p>
            <% } else { %>
            <div class="stat-value">n/a</div>
            <p class="stat-note">No bug has been resolved yet</p>
            <% } %>
          </div>
          <div class="card stat c-critical">
            <div class="stat-top"><span>Reopened rate</span><span class="stat-dot" aria-hidden="true"></span></div>
            <div class="stat-value"><span data-count="<%= reopenedRate %>" data-decimals="1"><%= reopenedRate %></span><small>%</small></div>
            <p class="stat-note">Bugs that came back after being closed</p>
          </div>
        </section>

        <div class="reports-grid enter" style="--i:2">
          <section class="card" aria-labelledby="catTitle" data-inview>
            <h2 class="card-title" id="catTitle">Bugs by category</h2>
            <p class="card-sub">Hover or focus a bar for the exact count.</p>
            <% if (byCategory.length === 0) { %>
              <div class="empty"><strong>Nothing to chart yet</strong>Report a bug to see categories here.</div>
            <% } else { %>
            <div class="chart" role="group" aria-label="Bugs by category">
              <% byCategory.forEach((c, i) => { %>
              <div class="bar-col" tabindex="0" role="img" style="--h: <%= Math.round((c.count / maxCount) * 100) %>%; --d: <%= i %>"
                   aria-label="<%= c.category %>: <%= plural(c.count) %>, <%= pct(c.count) %> percent"
                   data-tip-title="<%= c.category %>" data-tip="<%= plural(c.count) %> (<%= pct(c.count) %>% of all)">
                <span class="bar-val"><%= c.count %></span>
                <div class="bar"></div>
              </div>
              <% }) %>
            </div>
            <div class="axis" aria-hidden="true"><% byCategory.forEach(c => { %><span><%= c.category %></span><% }) %></div>
            <% } %>
          </section>

          <section class="card" aria-labelledby="statTitle" data-inview>
            <h2 class="card-title" id="statTitle">Status breakdown</h2>
            <p class="card-sub">Share of all bugs in each status.</p>
            <% if (statuses.length === 0) { %>
              <div class="empty"><strong>Nothing to chart yet</strong>Report a bug to see statuses here.</div>
            <% } else { %>
            <div class="stack-bar" role="group" aria-label="Bugs by status">
              <% statuses.forEach((s, i) => { %>
              <span class="stack-seg" tabindex="0" role="img" style="--n: <%= s.count %>; --c: <%= rgb[s.status] %>; --d: <%= i %>"
                    aria-label="<%= s.status %>: <%= plural(s.count) %>, <%= pct(s.count) %> percent"
                    data-tip-title="<%= s.status %>" data-tip="<%= plural(s.count) %> (<%= pct(s.count) %>% of all)"></span>
              <% }) %>
            </div>
            <ul class="legend">
              <% statuses.forEach(s => { %>
              <li><span class="badge <%= s.status.replace(' ', '-') %>"><%= s.status %></span><span class="num"><%= s.count %></span><span class="pct"><%= pct(s.count) %>%</span></li>
              <% }) %>
            </ul>
            <% } %>
          </section>
        </div>
<%- include('partials/shell-end') %>
