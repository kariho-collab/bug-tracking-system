<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Dashboard — Bug Tracker</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <%- include('partials/navbar', { user, active: 'dashboard' }) %>
  <div class="container">
    <h1>Dashboard</h1>
    <div class="stats-row">
      <div class="stat red"><div class="num"><%= counts.open %></div><div class="label">OPEN BUGS</div></div>
      <div class="stat orange"><div class="num"><%= counts.inProgress %></div><div class="label">IN PROGRESS</div></div>
      <div class="stat green"><div class="num"><%= counts.resolved %></div><div class="label">RESOLVED</div></div>
      <div class="stat purple"><div class="num"><%= counts.critical %></div><div class="label">CRITICAL</div></div>
    </div>

    <div class="card">
      <h2>Recent Bug Reports</h2>
      <table>
        <tr><th>ID</th><th>Title</th><th>Category</th><th>Priority</th><th>Status</th><th>Assigned</th></tr>
        <% recentBugs.forEach(b => { %>
          <tr>
            <td><a class="rowlink" href="/bugs/<%= b.bug_id %>">#<%= b.bug_id %></a></td>
            <td><%= b.title %></td>
            <td><%= b.category %></td>
            <td><span class="badge <%= b.priority %>"><%= b.priority %></span></td>
            <td><span class="badge <%= b.status.replace(' ', '-') %>"><%= b.status %></span></td>
            <td><%= b.assigned_to || '—' %></td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
</body>
</html>
