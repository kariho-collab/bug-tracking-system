<%- include('head', { title: title, bodyClass: 'app' }) %>
  <div class="scrim" id="scrim"></div>
  <div class="shell">
    <aside class="sidebar" id="sidebar" aria-label="Sidebar">
      <a class="brand" href="/dashboard">
        <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 8a4 4 0 018 0v1H8V8z"/><path d="M6.5 11h11v3.5a5.5 5.5 0 01-11 0V11z"/><path d="M3 12h3.5M17.5 12H21M4 19l2.6-1.6M20 19l-2.6-1.6M4 5l3 2M20 5l-3 2M12 11v8"/></svg></span>
        <span class="brand-text">BugTracker</span>
      </a>
      <nav class="nav" aria-label="Primary">
        <span class="nav-indicator" aria-hidden="true"></span>
        <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="/dashboard" <%- active === 'dashboard' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="9" rx="2"/><rect x="13.5" y="3" width="7.5" height="5" rx="2"/><rect x="13.5" y="11" width="7.5" height="10" rx="2"/><rect x="3" y="15" width="7.5" height="6" rx="2"/></svg>
          <span class="nav-label">Dashboard</span>
        </a>
        <a class="nav-link <%= active === 'report-bug' ? 'active' : '' %>" href="/report-bug" <%- active === 'report-bug' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
          <span class="nav-label">Report bug</span>
        </a>
        <a class="nav-link <%= active === 'bugs' ? 'active' : '' %>" href="/bugs" <%- active === 'bugs' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>
          <span class="nav-label">Bug tracker</span>
        </a>
        <a class="nav-link <%= active === 'reports' ? 'active' : '' %>" href="/reports" <%- active === 'reports' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20v-8M12 20V5M19 20v-12M2.5 20h19"/></svg>
          <span class="nav-label">Reports</span>
        </a>
        <% if (user && user.role === 'administrator') { %>
        <a class="nav-link <%= active === 'users' ? 'active' : '' %>" href="/users" <%- active === 'users' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 4.6a3.5 3.5 0 010 6.8M18.5 14.4c1.9.8 3 2.7 3 5.6"/></svg>
          <span class="nav-label">Users</span>
        </a>
        <% } %>
      </nav>
      <div class="sidebar-foot">
        <button class="collapse-btn" id="collapseBtn" type="button" aria-expanded="true" aria-label="Collapse sidebar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 17l-5-5 5-5M18 17l-5-5 5-5"/></svg>
          <span>Collapse</span>
        </button>
        <div class="menu" id="userMenu" aria-label="Account">
          <div class="menu-head"><strong><%= user.name %></strong><span><%= user.email %></span></div>
          <a href="/logout">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 012 2v12a2 2 0 01-2 2h-3M10 16l-4-4 4-4M6 12h10"/></svg>
            Log out
          </a>
        </div>
        <button class="user-chip" id="userChip" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="userMenu">
          <span class="avatar" aria-hidden="true"><%= user.name.trim().charAt(0).toUpperCase() %></span>
          <span class="user-meta"><strong><%= user.name %></strong><span><%= user.role %></span></span>
          <svg class="user-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
        </button>
      </div>
    </aside>
    <div class="main">
      <header class="topbar">
        <button class="menu-btn" id="menuBtn" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <a class="brand" href="/dashboard">
          <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 8a4 4 0 018 0v1H8V8z"/><path d="M6.5 11h11v3.5a5.5 5.5 0 01-11 0V11z"/><path d="M3 12h3.5M17.5 12H21M4 19l2.6-1.6M20 19l-2.6-1.6M4 5l3 2M20 5l-3 2M12 11v8"/></svg></span>
          <span>BugTracker</span>
        </a>
      </header>
      <main class="content" id="main">
        <div class="page-glow" aria-hidden="true"></div>
